{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "lastLoginAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Master syllabus subject containing hierarchical chapters and topics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 32 },
        "color": { "type": "string", "maxLength": 16 },
        "order": { "type": "number" },
        "chapters": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name", "code", "chapters"]
    },
    "Challenge": {
      "title": "Challenge",
      "description": "Study sprint challenge with participant progress tracking",
      "type": "object",
      "properties": {
        "challenge_id": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 16 },
        "created_by": { "type": "string", "maxLength": 128 },
        "duration": { "type": "number" },
        "start_date": { "type": "string", "maxLength": 64 },
        "selected_syllabus": { "type": "array" },
        "day_wise_allocation": { "type": "object" },
        "participants": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["challenge_id", "created_by", "duration", "selected_syllabus", "start_date", "participants"]
    },
    "WeeklySnapshot": {
      "title": "WeeklySnapshot",
      "description": "Weekly progress summary for comparison and leaderboard",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "weekKey": { "type": "string", "maxLength": 32 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "activeChallengeId": { "type": "string", "maxLength": 128 },
        "subjects": { "type": "array" },
        "topicsCompleted": { "type": "number" },
        "totalPlanned": { "type": "number" },
        "unitsCompleted": { "type": "number" },
        "streakDays": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "weekKey", "displayName", "subjects", "topicsCompleted", "totalPlanned", "unitsCompleted", "streakDays"]
    },
    "PeerLink": {
      "title": "PeerLink",
      "description": "Pair connection document between two accountability study buddies",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 260 },
        "uids": { "type": "array" },
        "status": { "type": "string", "enum": ["requested", "active", "rejected"] },
        "requestedBy": { "type": "string", "maxLength": 128 },
        "requesterName": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "uids", "status", "requestedBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Authenticated user profiles, roles, and account preferences"
    },
    "/master_syllabus/{subjectId}": {
      "schema": "Subject",
      "description": "Master syllabus subjects, chapters, and topics managed exclusively by admins"
    },
    "/user_progress/{userId}": {
      "schema": "User",
      "description": "User topic progress, peer codes, and completion logs"
    },
    "/challenges/{challengeId}": {
      "schema": "Challenge",
      "description": "Real-time cohort study challenges with participant progress synchronization"
    },
    "/weekly_snapshots/{snapshotId}": {
      "schema": "WeeklySnapshot",
      "description": "Weekly progress snapshots for all users, enabling peer comparison"
    },
    "/peer_links/{pairId}": {
      "schema": "PeerLink",
      "description": "1-on-1 peer links between accountability partners"
    }
  }
}
