rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        ((request.auth.token.email == 'ahmedtaseen008@gmail.com' || request.auth.token.email == 'ahmedmubintaseen@gmail.com') && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'role', 'photoURL', 'createdAt', 'lastLoginAt', 'joinedChallengeIds']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.name is string && data.name.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        (data.role == 'user' || data.role == 'admin') &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64)) &&
        (!('joinedChallengeIds' in data) || (data.joinedChallengeIds is list && data.joinedChallengeIds.size() <= 100));
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['id', 'name', 'code', 'chapters']) &&
        data.id is string && data.id.size() <= 64 &&
        data.name is string && data.name.size() <= 128 &&
        data.code is string && data.code.size() <= 32 &&
        data.chapters is list && data.chapters.size() <= 100;
    }

    function isLinkedPeer(userId) {
      let pairA = request.auth.uid + '_' + userId;
      let pairB = userId + '_' + request.auth.uid;
      return (exists(/databases/$(database)/documents/peer_links/$(pairA)) &&
              get(/databases/$(database)/documents/peer_links/$(pairA)).data.status == 'active') ||
             (exists(/databases/$(database)/documents/peer_links/$(pairB)) &&
              get(/databases/$(database)/documents/peer_links/$(pairB)).data.status == 'active');
    }

    // User profiles & RBAC collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) && incoming().uid == request.auth.uid && (
        incoming().role == 'user' ||
        (incoming().role == 'admin' && (request.auth.token.email == 'ahmedtaseen008@gmail.com' || request.auth.token.email == 'ahmedmubintaseen@gmail.com') && request.auth.token.email_verified == true)
      );
      allow update: if isValidId(userId) && (
        ((isOwner(userId) || isAdmin()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt', 'photoURL'])) ||
        (isValidUser(incoming()) && incoming().uid == existing().uid && (
          isAdmin() ||
          (isOwner(userId) && incoming().role == existing().role)
        ))
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Master syllabus collection (Curriculum maintained by admins only)
    match /master_syllabus/{subjectId} {
      allow get, list: if isSignedIn();
      allow create, update: if isValidId(subjectId) && isAdmin() && isValidSubject(incoming());
      allow delete: if isValidId(subjectId) && isAdmin();
    }

    // User progress persistence (personal progress = source of truth for rooms)
    // The doc holds only uid, progress flags, a completion log, a peer code and challenge ids,
    // so read can be open to signed-in users; writes stay owner-only so nobody can forge another member's progress.
    match /user_progress/{userId} {
      allow get, list: if isValidId(userId) && isSignedIn();
      allow create, update: if isValidId(userId) && isOwner(userId);
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Peer links (1-on-1 accountability buddy matching)
    match /peer_links/{pairId} {
      allow get, list: if isSignedIn() && (request.auth.uid in existing().uids || isAdmin());
      allow create: if isSignedIn() && (
        incoming().requestedBy == request.auth.uid &&
        request.auth.uid in incoming().uids
      );
      allow update: if isSignedIn() && (
        request.auth.uid in existing().uids &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
      );
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid in existing().uids);
    }

    // Challenges collection (Real-time cohort sprint coordination)
    match /challenges/{challengeId} {
      allow get, list: if isSignedIn();
      allow create: if isValidId(challengeId) && isSignedIn() && incoming().created_by == request.auth.uid;
      allow update: if isValidId(challengeId) && isSignedIn();
      allow delete: if isValidId(challengeId) && (isAdmin() || (isSignedIn() && existing().created_by == request.auth.uid));
    }
    
    // Weekly progress snapshots for comparison
    match /weekly_snapshots/{snapshotId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && (incoming().uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Health check endpoint for connection verification
    match /test/connection {
      allow read: if true;
    }
  }
}
